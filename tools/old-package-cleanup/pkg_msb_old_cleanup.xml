<?xml version="1.0" encoding="utf-8"?>
<extension type="package" method="upgrade">
	<name>PKG_FACILITYCALENDAR_MSB_OLD_CLEANUP</name>
	<packagename>facilitycalendar-msb-old-cleanup</packagename>
	<version>1.0.0</version>
	<creationDate>September 2026</creationDate>
	<author>Simcoe Curling Club</author>
	<copyright>Copyright (C) 2026 Simcoe Curling Club</copyright>
	<license>GNU General Public License version 2 or later</license>
	<description>PKG_FACILITYCALENDAR_MSB_OLD_CLEANUP_DESC</description>

	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.pkg_facilitycalendar_msb_old_cleanup.sys.ini</language>
	</languages>

	<!--
		The `class` attribute is REQUIRED. Without it Joomla infers the script
		class from the scriptfile filename ("script.php" => "scriptInstallerScript")
		and our class is never loaded. Explicitly naming the class guarantees the
		cleanup executes. Cleanup runs in postflight(), which fires on BOTH a
		fresh install and an upgrade (re-install), so it works however you install.
	-->
	<scriptfile class="pkg_facilitycalendar_msb_old_cleanupInstallerScript">script.php</scriptfile>
</extension>
