<?xml version="1.0" encoding="utf-8"?>
<extension type="file" version="3.10" method="upgrade">
	<name>PKG_FACILITYCALENDAR_MSB_OLD_CLEANUP</name>
	<packagename>facilitycalendar-msb-old-cleanup</packagename>
	<version>1.0.0</version>
	<creationDate>September 2026</creationDate>
	<author>Simcoe Curling Club</author>
	<copyright>Copyright (C) 2026 Simcoe Curling Club</copyright>
	<license>GNU General Public License version 2 or later</license>
	<description>PKG_FACILITYCALENDAR_MSB_OLD_CLEANUP_DESC</description>

	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.pkg_facilitycalendar_msb_old_cleanup.sys.ini</language>
	</languages>

	<scriptfile>script.php</scriptfile>

	<!--
		Joomla 3.10 FileAdapter derives the installer-script CLASS NAME from the
		MANIFEST FILENAME (pkg_msb_old_cleanup.xml -> pkg_msb_old_cleanupInstallerScript).
		The class attribute is NOT honoured, so script.php MUST declare that exact
		class name.

		Joomla 3.10 also REQUIRES a non-empty <fileset><files> for a type=file
		extension (line 546 iterates fileset->files; a Joomla-3 style <files> is
		ignored and yields the "foreach null" warning). One harmless .txt marker is
		installed to provide a valid install set and is removed on uninstall.
	-->
	<fileset>
		<files target="administrator/manifests/packages/cleanup">
			<filename>cleanup.txt</filename>
		</files>
	</fileset>
</extension>
